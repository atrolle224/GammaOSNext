+    let dot_no = u32(p.x) % 3u;
+    var mask = vec3<f32>(0.7, 0.7, 1.0);
+    if (dot_no == 0u) {
+        mask = vec3<f32>(1.0, 0.7, 0.7);
+    } else if (dot_no == 1u) {
+        mask = vec3<f32>(0.7, 1.0, 0.7);
+    }
+    col = col * mask;
+    return min(pow(col, vec3<f32>(1.0 / 1.8)) * 1.2, vec3<f32>(1.0));
 }
