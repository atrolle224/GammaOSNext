+    /**
+     * RG477M: with a controller (the built-in one) the touch pad starts hidden;
+     * texture packs go in Internal storage/EQOA/textures/SLUS-20744/replacements
+     * once all-files access is allowed (asked once), else in the app's
+     * Android/data folder.
+     */
+    private void rg477m() {
+        for (int id : InputDevice.getDeviceIds()) {
+            InputDevice d = InputDevice.getDevice(id);
+            if (d != null && !d.isVirtual() && isPad(d.getSources())) {
+                setenv("EQOA_TOUCH", "0");
+                break;
+            }
+        }
+        File home = null;
+        if (Build.VERSION.SDK_INT >= 30 && Environment.isExternalStorageManager()) {
+            home = new File(Environment.getExternalStorageDirectory(), "EQOA");
+        } else if (getExternalFilesDir(null) != null) {
+            home = getExternalFilesDir(null);
+        }
+        if (home != null) {
+            new File(home, "textures/SLUS-20744/replacements").mkdirs();
+            setenv("EQOA_TEXTURES_HOME", home.getPath());
+        }
+        android.content.SharedPreferences prefs = getSharedPreferences(PREFS, MODE_PRIVATE);
+        if (Build.VERSION.SDK_INT >= 30 && !Environment.isExternalStorageManager() && !prefs.getBoolean("askedFiles", false)) {
+            prefs.edit().putBoolean("askedFiles", true).apply();
+            new AlertDialog.Builder(this)
+                .setTitle("Texture packs")
+                .setMessage("Allow file access so HD texture packs can go in Internal storage/EQOA/textures/SLUS-20744/replacements "
+                    + "(then turn them on in Options > Extended > Textures). Restart the game after allowing it.")
+                .setPositiveButton("Allow", (dlg, w) -> {
+                    try {
+                        startActivity(new Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION, Uri.parse("package:" + getPackageName())));
+                    } catch (Exception e) {
+                        startActivity(new Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION));
+                    }
+                })
+                .setNegativeButton("Not now", null)
+                .show();
+        }
+    }
