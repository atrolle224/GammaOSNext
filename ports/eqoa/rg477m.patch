+// CRT Easymode's scanlines (224, the PS2's 448 a field) and aperture grille
+fn crt(c: vec3<f32>, p: vec2<f32>, height: f32) -> vec3<f32> {
+    let luma = dot(vec3<f32>(0.2126, 0.7152, 0.0722), c);
+    let bright = (max(c.r, max(c.g, c.b)) + luma) * 0.5;
+    let scan = 1.0 - pow(cos(p.y / height * 6.283185307 * 224.0) * 0.5 + 0.5, 1.5);
